# Copy to .env and fill in. Secrets only; everything else lives in config.yaml.

# Slack bot token (xoxb-...) and app-level token (xapp-...) from your Slack app
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Anthropic Console API key (pay-as-you-go; a Claude subscription does not cover it)
ANTHROPIC_API_KEY=

# Path to the Google service account JSON key. Keep it outside this repo.
GOOGLE_SERVICE_ACCOUNT_FILE=
